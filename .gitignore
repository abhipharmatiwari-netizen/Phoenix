# Runtime secrets — never commit
.backend-live.env.runtime

# Local diagnostic scripts (container-only, not for commit) — §109
phx_audit.py
phx_audit_*.py

# Logs (production) and runtime state
logs/
state/

# Test-run scratch directory (redirected via APP_LOG_DIR in tests/conftest.py)
.test_tmp/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/

# Environment overrides with real secrets
*.env.local
*.env.secrets

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude memory (local session state)
.claude/

# Operator-local scratch space for drafting GitHub issue bodies / comments
# before posting via `gh issue create`. Source of truth lives on GitHub.
.github/issue_drafts/

# Runtime env injections / operator-only files
*.env.runtime
*.runtime.env
.env.runtime
.env.oci-live
.env.oci-live.*

# Virtual environments
.venv/
venv/
env/

# Docker build cache and temporary artifacts
.docker-tmp/
*.log
*.tmp

# Release build artifacts (zip files are build outputs, not source)
release/*.zip

# Backtest artefacts
replay_output/
.backtest_venv/
debug.log

# OCI log pulls (local diagnostic snapshots, not for commit)
ops/oci_log_pulls/

# Node.js dependency installs (rebuilt from package-lock.json by Dockerfile/CI;
# also created locally when running tsc / npm install for typecheck).
node_modules/

# Frontend build and test output (produced locally or by the nginx Docker stage; not source).
frontend/build/
frontend/playwright-report/
frontend/test-results/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

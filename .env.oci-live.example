# OCI LIVE environment template
#
# Copy to .env.oci-live and fill in real values before deployment.
# This file documents all variables docker-compose.oci-live.yml expects.
# NEVER commit .env.oci-live to git — it contains production credentials.
#
# Populate by running: scripts/fetch-secrets.sh (pulls from OCI Vault)
# Then set the remaining non-secret vars below in your shell session or
# a .env.oci-live file that is NOT committed to the repo.

# ==== OCI Container Registry ====
OCIR_NAMESPACE=CHANGE_ME              # tenancy namespace (e.g. fra12abc34xyz)
OCIR_REGION=ap-mumbai-1
IMAGE_TAG=latest                      # or a specific SHA tag from CI

# ==== OCI PostgreSQL (private endpoint) ====
CONTROL_PLANE_PG_HOST=CHANGE_ME.postgresql.ap-mumbai-1.oci.oraclecloud.com
CONTROL_PLANE_PG_PORT=5432
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
# CONTROL_PLANE_PG_PASSWORD injected via /run/secrets/control_plane_pg_password
# CONTROL_PLANE_PG_PASSWORD_HOST is used by migrator/db-preflight containers only:
CONTROL_PLANE_PG_PASSWORD_HOST=CHANGE_ME   # same as vault secret value

# ==== Hub Identity (MUST be explicit — startup rejects empty or 'tenant-default') ====
HUB_DEFAULT_TENANT_ID=CHANGE_ME       # real production tenant UUID
HUB_DEFAULT_BROKER_ACCOUNT_ID=CHANGE_ME
HUB_INSTANCE_NAME=phoenix-oci-prod
LEADER_LEASE_ID=phoenix-oci-live

# ==== Angel Broking Network Identity (required in LIVE) ====
CLIENT_LOCAL_IP=CHANGE_ME
CLIENT_PUBLIC_IP=CHANGE_ME
MAC_ADDRESS=CHANGE_ME

# ==== Risk / Capital / Profit ====
CAPITAL_LIMITS_JSON={"CHANGE_ME_TENANT:CHANGE_ME_ACCOUNT":{"max_gross_exposure":500000,"max_net_exposure":500000}}
RISK_MAX_DAILY_LOSS=2000
PROFIT_DAILY_TARGET=10000

# ==== Host volume paths (OCI NFS mount points) ====
PHOENIX_LOG_HOST_PATH=/opt/phoenix/logs
PHOENIX_STATE_HOST_PATH=/opt/phoenix/state
PHOENIX_CERTS_HOST_PATH=/opt/phoenix/certs

# ==== OCI Vault configuration (for fetch-secrets.sh) ====
OCI_VAULT_ID=CHANGE_ME               # OCID of the phoenix-vault
OCI_VAULT_COMPARTMENT_ID=CHANGE_ME   # OCID of the phoenix-prod compartment

# ==== Optional: per-deployment tuning ====
EOD_EXIT_TIME=15:20
PROFIT_DAILY_TARGET_PAPER=10000
AUTO_STRATEGY_MAX_ACTIVE_PER_UNDERLYING=2
AUTO_STRATEGY_MIN_HOLD_SECONDS=180
PROFIT_MULTIPLE_TARGET=500
PROFIT_SWEEP_COOLDOWN_MINUTES=30
PROFIT_MAX_SWEEPS_PER_DAY=5
NIFTY_EMA20_LOTS=1
BANKNIFTY_EMA20_LOTS=1
FINNIFTY_EMA20_LOTS=1
MIDCPNIFTY_EMA20_LOTS=1
SENSEX_EMA20_LOTS=1
NG_EMA20_LOTS=1

# ==== OCI domain (used for CORS_ORIGINS in compose) ====
PHOENIX_DOMAIN=phoenix.yourdomain.com

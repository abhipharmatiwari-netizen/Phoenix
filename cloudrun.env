# =============================================================================
# TEMPLATE FILE — DO NOT USE IN PRODUCTION WITHOUT REPLACING ALL CHANGE_ME VALUES
# This file is a non-secret, non-current reference template for possible Cloud
# Run deployments. The current production runtime is the OCI VM documented in
# docs/OCI_VM_RUNTIME.md.
# Replace all CHANGE_ME values with deployment-time values before use.
# The auto-load guard in main.py (_env_file_looks_like_template) skips this
# file if CHANGE_ME markers are detected during local runs.
# Use docs/runbooks/cloudrun-live.env.example only as a roadmap reference template.
# =============================================================================
#
# Cloud Run reference profile
#
# Status:
# - Reference and roadmap material only
# - Not the bundled go-live path
# - Keep this file non-secret
#
# §130 / Issue #9: DO NOT fill in real values and run this file directly.
# If you replace the CHANGE_ME placeholders, the auto-load guard in main.py
# will no longer protect against accidental loading.  Use
# docs/runbooks/cloudrun-live.env.example as roadmap reference material and
# supply TRADE_MODE via Cloud Run environment
# variables — not this file.
#
# TRADE_MODE must be set via Cloud Run environment configuration, not
# hard-coded in this reference file.  Setting it here to LIVE is
# misleading because operators could partially fill this file and create
# a misconfigured deployment.

LOG_LEVEL=INFO
APP_ENV=production
TZ=Asia/Kolkata
POSTGRES_SESSION_TIMEZONE=Asia/Kolkata
LOG_FILE_PER_PROCESS=false
RUNNER_MODE=uvicorn
HOST=0.0.0.0
PORT=8080

GCP_PROJECT_ID=CHANGE_ME

CONTROL_PLANE_BACKEND=postgres
SWEEP_STATE_BACKEND=postgres
CONTROL_PLANE_PG_HOST=CHANGE_ME
CONTROL_PLANE_PG_PORT=5432
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
# Bind DB password via Secret Manager or platform secret injection.
# CONTROL_PLANE_PG_PASSWORD=<SET_BY_PLATFORM_SECRET>
POSTGRES_FORCE_IPV4=true
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

BROKER_SECRET_BACKEND=secret_manager
# Secret Manager secret IDs are stored in the private ops secrets store — not committed here.
ADMIN_API_KEY_SECRET=CHANGE_ME

DEFAULT_TIME_ZONE=Asia/Kolkata
APP_RUNTIME_STARTUP_VALIDATE=true
SCHEMA_CHECK_MODE=strict
RUNTIME_CONFIG_AUTO_ENABLE=false
ENABLE_DEMO_AUTH=false
DASHBOARD_AUTH_DISABLED=false
DISABLE_CONTROL_TOWER_ROUTES=true
# Bind AUTH_TOKEN_SECRET via Secret Manager or platform secret injection.
# AUTH_TOKEN_SECRET=<SET_BY_PLATFORM_SECRET>

USE_HUB_ROUTER=true
ENABLE_MULTI_HUB=true
DISABLE_STREAM_WORKER=false
HUB_DEFAULT_TENANT_ID=tenant-1
# TRADE_MODE must be set via Cloud Run environment variables, not this file.
# See docs/runbooks/cloudrun-live.env.example for the Cloud Run reference
# profile.  §130: removed TRADE_MODE=LIVE to prevent
# partially-filled deployments from inheriting a live trade mode accidentally.
# TRADE_MODE=<SET_VIA_CLOUD_RUN_ENVIRONMENT>
# REQUIRE_LIVE_TRADE_MODE=true  # set this in Cloud Run env alongside TRADE_MODE

ENABLE_CAPITAL_CHECKS=true
CAPITAL_FAIL_CLOSED_ON_MISSING_STATE=true
CAPITAL_FAIL_CLOSED_ON_MISSING_NOTIONAL_PRICE=true
ENABLE_RISK_CHECKS=true
RISK_ENABLE_DAILY_LOSS=true
# Daily realised+unrealised drawdown ceiling in INR. Placeholder — LIVE
# startup fails if this is below RISK_MAX_DAILY_LOSS_LIVE_FLOOR (default
# ₹5,000). Size per capital tier; see docs/runbooks/oci_live_deployment.md
# (issue #221).
RISK_MAX_DAILY_LOSS=CHANGE_ME_DAILY_LOSS_INR
ENABLE_PROFIT_CHECKS=true
PROFIT_ENABLE_DAILY_TARGET=true
PROFIT_DAILY_TARGET=10000
PROFIT_BLOCK_NEW_ORDERS_ON_TARGET=true
ORDER_ROUTER_ENFORCE_IDEMPOTENCY=true
ORDER_ROUTER_ENFORCE_GLOBAL_KILL_SWITCH=true
POSITION_OWNERSHIP_ENABLED=true
POSITION_OWNERSHIP_UNKNOWN_MODE=block_entries
ORDER_LIFECYCLE_PERSIST_MARKERS_REQUIRED=true
ORDER_SUBMISSION_OUTBOX_REQUIRED=true
CIRCUIT_BREAKER_PERSIST_STATE=true
ENABLE_EOD_EXIT=true
EOD_CANCEL_OPEN_ORDERS_ENABLED=true

# phoenix-override.yml.example
#
# Status: mirrors the current /opt/phoenix/phoenix-override.yml shape verified on
# the OCI VM on 2026-06-06. Keep filled copies off git.
#
# This is a current-state template, not a target-state recommendation. It
# includes local images, VM-local Postgres wiring, nginx prerendered config, and
# source-file bind mounts because those are what the VM is running today. The
# VM-local Postgres service itself is managed through the base manifest's
# vm-local-postgres profile.

name: phoenix-oci-live

services:
  backend:
    image: phoenix-local-backend:${IMAGE_TAG}
    environment:
      # Optional broker egress proxy. Use the operator-approved proxy host only.
      ANGEL_HTTPS_PROXY: "http://<PROXY_HOST>:8888"
      HTTPS_PROXY: "http://<PROXY_HOST>:8888"

      CORS_ORIGINS: "https://<PHOENIX_DOMAIN>"

      # Current VM-local Postgres path.
      CONTROL_PLANE_DB_DSN: "postgresql://phoenix_app@phoenix-oci-postgres:5432/phoenix"
      CONTROL_PLANE_PG_SSLMODE: "prefer"
      LIVE_PG_SSL_SKIP_CHECK: "true"
      REMOTE_DEPLOYMENT: "false"

      DISABLE_CONTROL_TOWER_ROUTES: "true"

    volumes:
      - "/opt/phoenix/logs:/app/logs"
      - "/opt/phoenix/state:/app/state"
      - "/opt/phoenix/certs:/app/certs:ro"

      # Current VM drift: selected source files are bind-mounted over the image.
      # Remove only through an approved deployment change and fresh VM evidence.
      - "/opt/phoenix/app/app/core/angel_login.py:/app/app/core/angel_login.py:ro"
      - "/opt/phoenix/app/app/core/order_client.py:/app/app/core/order_client.py:ro"
      - "/opt/phoenix/app/app/core/universe_builder.py:/app/app/core/universe_builder.py:ro"
      - "/opt/phoenix/app/app/core/ws_runner.py:/app/app/core/ws_runner.py:ro"
      - "/opt/phoenix/app/app/runtime/app_runtime.py:/app/app/runtime/app_runtime.py:ro"
      - "/opt/phoenix/app/app/server.py:/app/app/server.py:ro"
      - "/opt/phoenix/app/app/api/auth_routes.py:/app/app/api/auth_routes.py:ro"
      - "/opt/phoenix/app/app/config/settings.py:/app/app/config/settings.py:ro"
      - "/opt/phoenix/app/app/hub/account_runner.py:/app/app/hub/account_runner.py:ro"
      - "/opt/phoenix/app/app/strategies/adaptive/strategy_selector.py:/app/app/strategies/adaptive/strategy_selector.py:ro"
      - "/opt/phoenix/app/app/config/strategy_env.yaml:/app/app/config/strategy_env.yaml:ro"

  nginx:
    image: phoenix-local-nginx:${IMAGE_TAG}
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    healthcheck:
      test: ["CMD-SHELL", "wget -q --no-check-certificate -O - https://127.0.0.1:8443/nginx-health >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    ports:
      - "0.0.0.0:80:80"
      - "0.0.0.0:8443:8443"
    volumes:
      - "/opt/phoenix/nginx-ssl-prerendered.conf.template:/tmp/nginx.conf.template:ro"
      - "/opt/phoenix/certs:/etc/letsencrypt:ro"
      - "/opt/phoenix/acme-challenge:/var/www/acme-challenge:ro"

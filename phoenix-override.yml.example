# phoenix-override.yml.example
#
# Copy to /opt/phoenix/phoenix-override.yml on the OCI VM and fill in real
# deployment values. The filled copy is an operator-owned runtime file and must
# not be committed to git.
#
# Usage:
#   CONTROL_PLANE_PG_PASSWORD_HOST=dummy docker compose \
#     -f /opt/phoenix/app/docker-compose.oci-live.yml \
#     -f /opt/phoenix/phoenix-override.yml \
#     --env-file /opt/phoenix/phoenix-deploy.env \
#     up -d --no-deps backend nginx
#
# CONTROL_PLANE_PG_PASSWORD_HOST=dummy satisfies compose interpolation for the
# migrator service when deploying only backend/nginx. The backend reads the real
# password from /run/secrets/control_plane_pg_password.
#
# LIVE invariants:
#   - No source-code bind mounts. Deploy a pinned image tag instead.
#   - No LIVE_PG_SSL_SKIP_CHECK=true for remote/cloud Postgres.
#   - No repo-stored ADMIN_API_KEY, broker credential, DB password, or token.
#   - nginx must mount the repo template, not a rendered config containing keys.

name: phoenix-oci-live

services:
  backend:
    environment:
      # Optional broker egress proxy. Leave unset if Angel One accepts the OCI
      # outbound IP directly.
      # ANGEL_HTTPS_PROXY: "http://PROXY_HOST:8888"
      # HTTPS_PROXY: "http://PROXY_HOST:8888"

      CORS_ORIGINS: "https://CHANGE_ME_PHOENIX_DOMAIN"

      # Repo-tracked OCI Compose uses an external Postgres endpoint supplied by
      # phoenix-deploy.env. Remote/cloud Postgres must use SSL.
      CONTROL_PLANE_PG_SSLMODE: "require"
      REMOTE_DEPLOYMENT: "true"

      DISABLE_CONTROL_TOWER_ROUTES: "true"

    volumes:
      - "/opt/phoenix/logs:/app/logs"
      - "/opt/phoenix/state:/app/state"
      - "/opt/phoenix/certs:/app/certs:ro"

  nginx:
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    healthcheck:
      test: ["CMD-SHELL", "wget -q --no-check-certificate -O - https://127.0.0.1:8443/readyz >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    ports:
      - "0.0.0.0:80:80"
      - "0.0.0.0:8443:8443"
    volumes:
      - "/opt/phoenix/app/nginx/nginx-ssl.conf.template:/tmp/nginx.conf.template:ro"
      - "/opt/phoenix/certs:/etc/letsencrypt:ro"
      - "/opt/phoenix/acme-challenge:/var/www/acme-challenge:ro"

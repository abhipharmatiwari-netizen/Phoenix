# ===========================================================================
# Phoenix v9 Environment Configuration Template
# Copy to localrun.env (local dev) or staging.env (staging) and fill values.
# NEVER commit real secrets to version control.
# NON-CURRENT FOR PRODUCTION: the OCI VM uses /opt/phoenix/phoenix-deploy.env
# plus /run/secrets. Do not use this file for OCI live operations.
# ==========================================================================
# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_PER_PROCESS=true
AUDIT_LOG_PATH=logs/audit_events.jsonl

# --- Server ---
APP_ENV=local
RUNNER_MODE=uvicorn
HOST=0.0.0.0
PORT=8080

# --- Backend Stores ---
CONTROL_PLANE_BACKEND=postgres
SWEEP_STATE_BACKEND=postgres
# Local/dev compatibility default. LIVE requires BROKER_SECRET_BACKEND=secret_manager or postgres.
BROKER_SECRET_BACKEND=postgres

# --- PostgreSQL (control plane) ---
CONTROL_PLANE_PG_HOST=localhost
CONTROL_PLANE_PG_PORT=5432
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
CONTROL_PLANE_PG_PASSWORD=CHANGE_ME          # <-- secret

# --- Auth & Security ---
ADMIN_API_KEY=CHANGE_ME                       # <-- secret
DASHBOARD_AUTH_DISABLED=false                 # true only in local dev
# DASHBOARD_HMAC_SECRET=                     # <-- secret (optional, for HMAC auth)
# DASHBOARD_HMAC_MAX_SKEW_SECONDS=300
# LIVE_RUNTIME_OVERRIDE_BREAK_GLASS=false     # temporary LIVE override escape hatch
# LIVE_RUNTIME_OVERRIDE_BREAK_GLASS_APPROVED_BY=
# LIVE_RUNTIME_OVERRIDE_BREAK_GLASS_UNTIL=    # ISO-8601 UTC timestamp, e.g. 2026-03-12T18:00:00Z

# --- Trade Mode ---
TRADE_MODE=PAPER                              # PAPER | LIVE | SHADOW
DISABLE_TRADING_WINDOW_FILTER=false
APP_RUNTIME_STARTUP_VALIDATE=true
SCHEMA_CHECK_MODE=strict

# --- Hub Routing ---
USE_HUB_ROUTER=true
ENABLE_MULTI_HUB=true
# HUB_AUTHORITATIVE requires ENABLE_MULTI_HUB=true and USE_HUB_ROUTER=true.
# For the current automated LIVE baseline keep DISABLE_STREAM_WORKER=false.
HUB_DEFAULT_TENANT_ID=tenant-1
HUB_DEFAULT_BROKER_ACCOUNT_ID=A1
# HUB_ROUTES_JSON={}                         # JSON map of strategy->account routes

# --- Execution Integrity ---
ORDER_SUBMISSION_OUTBOX_ENABLED=true
ORDER_SUBMISSION_OUTBOX_REQUIRED=true
ORDER_SUBMISSION_OUTBOX_BACKEND=postgres
ORDER_SUBMISSION_OUTBOX_TABLE=order_submission_outbox
EXECUTION_PORT_RESILIENCE_ENABLED=true
EXECUTION_PORT_RETRY_MAX_ATTEMPTS=2
EXECUTION_PORT_RETRY_BASE_SECONDS=0.5
EXECUTION_PORT_RETRY_MAX_SECONDS=5.0
EXECUTION_PORT_CIRCUIT_BREAKER_ENABLED=true
EXECUTION_PORT_CIRCUIT_FAILURE_THRESHOLD=3
EXECUTION_PORT_CIRCUIT_BASE_SECONDS=10.0
EXECUTION_PORT_CIRCUIT_MAX_SECONDS=120.0

# --- Strategy Quantities ---
# EMA20 uses canonical *_EMA20_LOTS keys. Use legacy *_EMA20_QTY only for compatibility.
NIFTY_EMA20_LOTS=1
BANKNIFTY_EMA20_LOTS=1
FINNIFTY_EMA20_LOTS=1
MIDCPNIFTY_EMA20_LOTS=1
SENSEX_EMA20_LOTS=1
NG_EMA20_LOTS=1

# --- Risk Management ---
ENABLE_CAPITAL_CHECKS=true
CAPITAL_LIMITS_JSON={}
CAPITAL_FAIL_CLOSED_ON_MISSING_STATE=true
CAPITAL_FAIL_CLOSED_ON_MISSING_NOTIONAL_PRICE=true
ENABLE_RISK_CHECKS=true
RISK_ENABLE_DAILY_LOSS=true
# RISK_MAX_DAILY_LOSS: absolute daily realised+unrealised drawdown ceiling in INR.
# The kill switch trips when |daily_pnl| exceeds this value. The previous
# committed default of 2000 was a placeholder that tripped on a ~1.6-point
# adverse move on a single NG_FUT lot (issue #221). LIVE startup now fails
# closed if this is below ``RISK_MAX_DAILY_LOSS_LIVE_FLOOR`` (default ₹5,000).
# Size per capital tier: e.g. ₹10,000 for a ₹1–2L account, ₹50,000+ for ₹10L+
# capital. See ``docs/runbooks/oci_live_deployment.md`` →
# "Sizing the daily-loss limit by capital tier".
RISK_MAX_DAILY_LOSS=CHANGE_ME_DAILY_LOSS_INR
RISK_FAIL_OPEN_ON_MISSING_PNL=false
ENABLE_PROFIT_CHECKS=true
PROFIT_ENABLE_DAILY_TARGET=true
PROFIT_DAILY_TARGET=10000
PROFIT_DAILY_TARGET_PAPER=10000
PROFIT_BLOCK_NEW_ORDERS_ON_TARGET=true
ORDER_ROUTER_ENFORCE_IDEMPOTENCY=true
POSITION_OWNERSHIP_ENABLED=true
POSITION_OWNERSHIP_UNKNOWN_MODE=block_entries
ORDER_LIFECYCLE_PERSIST_MARKERS_REQUIRED=true

# --- EOD Exit ---
ENABLE_EOD_EXIT=true
EOD_EXIT_TIME=15:20
EOD_EXIT_EXCLUDED_EXCHANGES=MCX

# --- ML ---
ML_ENABLED=false
ML_MODE=OFF

# --- Stream / Sync ---
POSITION_SYNC_INTERVAL_SECONDS=30
ORDERS_SYNC_INTERVAL_SECONDS=90
STREAM_SELF_HEAL_TOKEN_LABELS=false
STREAM_DROP_UNMAPPED_TICKS=false

# --- Indicator Storage ---
INDICATOR_CSV_ENABLED=false
INDICATOR_POSTGRES_ENABLED=true
INDICATOR_POSTGRES_TABLE=indicator_bars
INDICATOR_POSTGRES_RETENTION_MONTHS=3
INDICATOR_SEED_BARS=300

# --- Broker Cooldown ---
ANGEL_FETCH_COOLDOWN_BASE_SECONDS=5
ANGEL_FETCH_COOLDOWN_MAX_SECONDS=120
ANGEL_FETCH_RATE_LIMIT_FLOOR_SECONDS=90

# --- Profit Sweep ---
PROFIT_SWEEP_ENABLED=true
PROFIT_SWEEP_STRATEGY=SIMPLE
PROFIT_SIMPLE_ENABLED=true
PROFIT_MULTIPLE_ENABLED=false

# --- Network (broker API) ---
# LIVE requires explicit real values; loopback and fake MAC defaults are rejected.
# CLIENT_PUBLIC_IP=
# CLIENT_LOCAL_IP=
# MAC_ADDRESS=

# --- Postback Tokens ---
# ANGEL_POSTBACK_TOKEN=                      # <-- secret
# ANGEL_POSTBACK_RELAY_TOKEN=                # <-- secret


upstream backend {
    server backend:8080;
}

# Rate-limiting zones (applied per client IP)
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=admin:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=webhook:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=60r/m;

# Port 80: ACME challenges + OCI LB health checks pass through; everything else → HTTPS
server {
    listen 80;
    server_name _;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # OCI Load Balancer health check hits port 80 — must return 200, not 301
    location = /health {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location = /health/summary {
        proxy_pass http://backend/health/summary-public;
        proxy_set_header Host $host;
    }

    location = /readyz {
        proxy_pass http://backend/readyz-public;
        proxy_set_header Host $host;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
        try_files $uri =404;
    }

    # Do not let sensitive scanner paths redirect to HTTPS or fall through.
    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location ~* ^/(?:___proxy_subdomain_whm|cgi-bin|phpmyadmin|pma|wp-admin|wp-content|wp-includes|wp-json|sslvpn|manager/html)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:wp-config(?:\.|/|$)|login\.html$) {
        return 404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 8443: HTTPS with Let's Encrypt cert + full security headers
server {
    listen 8443 ssl;
    server_name _;
    http2 on;

    # Certificate path is parameterized via PHOENIX_DOMAIN env var.
    # The nginx Dockerfile substitutes ${PHOENIX_DOMAIN} at container start.
    ssl_certificate     /etc/letsencrypt/live/${PHOENIX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PHOENIX_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # CSP: unsafe-inline/unsafe-eval are required by the current React build (inline styles + CRA).
    # TODO: migrate to nonce-based CSP when build pipeline supports it (tracked: F-13 hardening gap).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self';" always;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Do not let sensitive scanner paths fall through to the React SPA.
    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location ~* ^/(?:___proxy_subdomain_whm|cgi-bin|phpmyadmin|pma|wp-admin|wp-content|wp-includes|wp-json|sslvpn|manager/html)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:wp-config(?:\.|/|$)|login\.html$) {
        return 404;
    }

    location /bff/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /health  { proxy_pass http://backend; proxy_set_header Host $host; }
    location = /health/summary  { proxy_pass http://backend/health/summary-public; proxy_set_header Host $host; }
    location = /health/alerts  { proxy_pass http://backend; proxy_set_header Host $host; }
    location = /health/mitigations  { proxy_pass http://backend; proxy_set_header Host $host; }
    location = /ready   { proxy_pass http://backend; proxy_set_header Host $host; }
    location = /readyz  { proxy_pass http://backend/readyz-public; proxy_set_header Host $host; }
    location = /start   { proxy_pass http://backend; proxy_set_header Host $host; }

    location /metrics {
        if ($http_x_admin_key != "${ADMIN_API_KEY}") { return 403; }
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location /webhook/ {
        limit_req zone=webhook burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /admin/ {
        limit_req zone=admin burst=20 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /tenant/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ml/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Control tower routes blocked at the nginx layer for cloud deployments.
    # Backend also enforces DISABLE_CONTROL_TOWER_ROUTES=true as defence-in-depth.
    location /api/control_tower/ {
        return 404;
    }

    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    location = /index.html { add_header Cache-Control "no-store"; }
    location / { try_files $uri $uri/ /index.html; }
}

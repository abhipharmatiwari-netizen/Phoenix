upstream backend {
    server backend:8080;
}

map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ""      $host;
}

map $http_accept $phoenix_positions_accepts_json {
    default 0;
    "~*application/json" 1;
}

map $arg_broker_account_id $phoenix_positions_has_account_arg {
    default 0;
    "" 0;
    "~.+" 1;
}

map "$phoenix_positions_accepts_json$phoenix_positions_has_account_arg" $phoenix_legacy_positions_api {
    default 0;
    "~1" 1;
}

log_format phoenix_no_query '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                            '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';
access_log /var/log/nginx/access.log phoenix_no_query;

# Rate-limiting zones (applied per client IP)
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=admin:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=webhook:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=60r/m;

# Port 80: ACME challenges + OCI LB health checks pass through; everything else → HTTPS
server {
    listen 80;
    server_name _;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # OCI Load Balancer health check hits port 80 — must return 200, not 301
    location = /health {
        proxy_pass http://backend;
        proxy_set_header Host backend;
    }

    location = /health/summary {
        proxy_pass http://backend/health/summary-public;
        proxy_set_header Host backend;
    }

    location = /readyz {
        proxy_pass http://backend/readyz-public;
        proxy_set_header Host backend;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
        try_files $uri =404;
    }

    # Do not let sensitive scanner paths redirect to HTTPS or fall through.
    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location ~* ^/(?:___proxy_subdomain_whm|cgi-bin|phpmyadmin|pma|wp-admin|wp-content|wp-includes|wp-json|sslvpn|manager/html)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:wp-config(?:\.|/|$)|login\.html$) {
        return 404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 8443: HTTPS with Let's Encrypt cert + full security headers
server {
    listen 8443 ssl;
    server_name _;
    http2 on;

    # Certificate path is parameterized via PHOENIX_DOMAIN env var.
    # The nginx Dockerfile substitutes ${PHOENIX_DOMAIN} at container start.
    ssl_certificate     /etc/letsencrypt/live/${PHOENIX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PHOENIX_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Inline styles are still used by the current React console; scripts remain self-hosted only.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Do not let sensitive scanner paths fall through to the React SPA.
    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location ~* ^/(?:___proxy_subdomain_whm|cgi-bin|phpmyadmin|pma|wp-admin|wp-content|wp-includes|wp-json|sslvpn|manager/html)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:wp-config(?:\.|/|$)|login\.html$) {
        return 404;
    }

    location /bff/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /health  { proxy_pass http://backend; proxy_set_header Host backend; }
    location = /health/summary  { proxy_pass http://backend/health/summary-public; proxy_set_header Host backend; }
    location = /health/alerts  { proxy_pass http://backend; proxy_set_header Host backend; }
    location = /health/mitigations  { proxy_pass http://backend; proxy_set_header Host backend; }
    location = /ready   { proxy_pass http://backend; proxy_set_header Host backend; }
    location = /readyz  { proxy_pass http://backend/readyz-public; proxy_set_header Host backend; }
    location = /start   { proxy_pass http://backend; proxy_set_header Host backend; }

    location /metrics {
        if ($http_x_admin_key != "${ADMIN_API_KEY}") { return 403; }
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location /webhook/ {
        limit_req zone=webhook burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /admin/ {
        limit_req zone=admin burst=20 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /tenant/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Legacy API clients use /positions. Browser navigations keep the React route.
    error_page 418 = @legacy_positions_api;
    location = /positions {
        if ($phoenix_legacy_positions_api) {
            return 418;
        }
        try_files $uri $uri/ /index.html;
    }

    location @legacy_positions_api {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ml/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Control tower routes blocked at the nginx layer for cloud deployments.
    # Backend also enforces DISABLE_CONTROL_TOWER_ROUTES=true as defence-in-depth.
    location /api/control_tower/ {
        return 404;
    }

    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
    }

    location = /index.html {
        add_header_inherit merge;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
    }

    location = /manifest.json {
        add_header_inherit merge;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
        try_files /manifest.json =404;
    }

    location = /favicon.ico {
        rewrite ^ /favicon.svg last;
    }

    location = /favicon.svg {
        add_header_inherit merge;
        add_header Cache-Control "public, max-age=86400" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
        try_files /favicon.svg =404;
    }

    location /static/ {
        add_header_inherit merge;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' wss: https:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
        try_files $uri =404;
    }

    location / { try_files $uri $uri/ /index.html; }
}

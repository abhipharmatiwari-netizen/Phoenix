upstream backend {
    server backend:8080;
}

# Prefer the X-Forwarded-Proto sent by an upstream load balancer (e.g. OCI LB,
# AWS ALB) so the backend sees the client-facing protocol (https).  Falls back
# to $scheme when no LB header is present (local Docker Desktop deployment).
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API and BFF proxy
    location /bff/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /auth/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /health {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location /ready {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location /readyz {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location /start {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location /metrics {
        # Restrict to internal scrape path — require admin key or deny externally.
        if ($http_x_admin_key != "${ADMIN_API_KEY}") {
            return 403;
        }
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    # Angel broker postback webhook — critical for order fill notifications
    location /webhook/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Admin routes — strategy management, instrument control
    location /admin/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Tenant routes — account positions, orders, PnL
    location /tenant/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # ML health endpoint
    location /ml/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Control tower routes — strategy selector matrix and toggles (only when enabled in backend)
    location /api/control_tower/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # WebSocket support
    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # No static admin key injection — WebSocket auth uses per-connection tickets.
        proxy_read_timeout 86400;
    }

    # Frontend static files — React SPA fallback
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

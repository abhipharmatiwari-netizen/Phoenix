upstream backend {
    server backend:8080;
}

# Rate-limiting zones (applied per client IP)
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=admin:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=webhook:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=60r/m;

# Prefer the X-Forwarded-Proto sent by an upstream load balancer (e.g. OCI LB,
# AWS ALB) so the backend sees the client-facing protocol (https).
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers (applied on all responses, including HTML)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # API and BFF proxy
    location /bff/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location = /health {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location = /health/summary {
        proxy_pass http://backend/health/summary-public;
        proxy_set_header Host $host;
    }

    location /ready {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location = /readyz {
        proxy_pass http://backend/readyz-public;
        proxy_set_header Host $host;
    }

    location /start {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    location /metrics {
        # Restrict to internal scrape path — require admin key or deny.
        if ($http_x_admin_key != "${ADMIN_API_KEY}") {
            return 403;
        }
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    # Angel broker postback webhook
    location /webhook/ {
        limit_req zone=webhook burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Admin routes — strategy management, instrument control
    location /admin/ {
        limit_req zone=admin burst=20 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Tenant routes — account positions, orders, PnL
    location /tenant/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # ML health endpoint
    location /ml/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Control tower routes are blocked at the nginx layer for cloud deployments.
    # The backend also enforces DISABLE_CONTROL_TOWER_ROUTES=true as defence-in-depth.
    location /api/control_tower/ {
        return 404;
    }

    # WebSocket support
    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    # Frontend static files — React SPA fallback
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

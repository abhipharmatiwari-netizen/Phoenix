upstream backend {
    server backend:8080;
}

# Rate-limiting zones (applied per client IP)
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=admin:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=webhook:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=60r/m;

# Prefer the X-Forwarded-Proto sent by an upstream load balancer (e.g. OCI LB,
# AWS ALB) so the backend sees the client-facing protocol (https).
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}

map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ""      $host;
}

log_format phoenix_no_query '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                            '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';
access_log /var/log/nginx/access.log phoenix_no_query;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers (applied on all responses, including HTML)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # API and BFF proxy
    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        try_files $uri =404;
    }

    # Do not let sensitive scanner paths fall through to the React SPA.
    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location ~* ^/(?:___proxy_subdomain_whm|cgi-bin|phpmyadmin|pma|wp-admin|wp-content|wp-includes|wp-json|sslvpn|manager/html)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:wp-config(?:\.|/|$)|login\.html$) {
        return 404;
    }

    location /bff/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location = /health {
        proxy_pass http://backend;
        proxy_set_header Host backend;
    }

    location = /health/summary {
        proxy_pass http://backend/health/summary-public;
        proxy_set_header Host backend;
    }

    location = /health/alerts {
        proxy_pass http://backend;
        proxy_set_header Host backend;
    }

    location = /health/mitigations {
        proxy_pass http://backend;
        proxy_set_header Host backend;
    }

    location /ready {
        proxy_pass http://backend;
        proxy_set_header Host backend;
    }

    location = /readyz {
        proxy_pass http://backend/readyz-public;
        proxy_set_header Host backend;
    }

    location /start {
        proxy_pass http://backend;
        proxy_set_header Host backend;
    }

    location /metrics {
        # Restrict to internal scrape path — require admin key or deny.
        if ($http_x_admin_key != "${ADMIN_API_KEY}") {
            return 403;
        }
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    # Angel broker postback webhook
    location /webhook/ {
        limit_req zone=webhook burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Admin routes — strategy management, instrument control
    location /admin/ {
        limit_req zone=admin burst=20 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Tenant routes — account positions, orders, PnL
    location /tenant/ {
        limit_req zone=general burst=30 nodelay;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # ML health endpoint
    location /ml/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Control tower routes are blocked at the nginx layer for cloud deployments.
    # The backend also enforces DISABLE_CONTROL_TOWER_ROUTES=true as defence-in-depth.
    location /api/control_tower/ {
        return 404;
    }

    # WebSocket support
    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 86400;
    }

    # Frontend static files — React SPA fallback
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location = /manifest.json {
        add_header Cache-Control "no-store";
        try_files /manifest.json =404;
    }

    location = /favicon.ico {
        rewrite ^ /favicon.svg last;
    }

    location = /favicon.svg {
        add_header Cache-Control "public, max-age=86400";
        try_files /favicon.svg =404;
    }

    location /static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

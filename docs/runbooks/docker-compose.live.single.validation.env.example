# Non-secret env file for validating docker-compose.live.single.yml.
#
# Usage:
#   Copy this file to an ignored local path, for example:
#     .artifacts/compose-validation/docker-compose.live.single.validation.env
#   Create placeholder files under PHX_SECRET_DIR when running `docker compose config`.
#   Do not use this file to start a LIVE stack. Values are placeholders only.
#
# Validation command:
#   docker compose --env-file .artifacts/compose-validation/docker-compose.live.single.validation.env `
#     -f docker-compose.live.single.yml config

CONTROL_PLANE_PG_HOST=host.docker.internal
CONTROL_PLANE_PG_PORT=5432
CONTROL_PLANE_PG_DB=phoenix_validation
CONTROL_PLANE_PG_USER=phoenix_validation
CONTROL_PLANE_PG_PASSWORD_HOST=placeholder-not-a-secret
CONTROL_PLANE_PG_SSLMODE=disable
LIVE_PG_SSL_SKIP_CHECK=true

CLIENT_LOCAL_IP=127.0.0.1
CLIENT_PUBLIC_IP=127.0.0.1
MAC_ADDRESS=00:00:00:00:00:00

PHX_SECRET_DIR=.artifacts/compose-validation/secrets
VULTR_REVERSE_TUNNEL_SSH_KEY=.artifacts/compose-validation/secrets/vultr_reverse_tunnel_ssh_key

CAPITAL_LIMITS_JSON={"A1":{"max_notional":100000,"max_quantity":1}}
RISK_MAX_DAILY_LOSS=10000

PHOENIX_LOG_HOST_PATH=./logs
PHOENIX_STATE_HOST_PATH=./state

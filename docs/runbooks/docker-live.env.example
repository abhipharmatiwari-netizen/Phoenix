# Legacy multi-file Docker LIVE env reference
#
# Status:
# - Non-secret reference only.
# - Not the bundled go-live manifest.
# - Do not store real secrets here.
# - LIVE secrets must come from Secret Manager or Postgres.
# - Short-lived runtime env injection may transport those values, but this file is never a LIVE secret source.
# - Set broker network identity explicitly at deploy time; LIVE rejects loopback/fake defaults.

LOG_LEVEL=INFO
APP_ENV=production
TZ=Asia/Kolkata
POSTGRES_SESSION_TIMEZONE=Asia/Kolkata
LOG_FILE_PER_PROCESS=true
RUNNER_MODE=uvicorn
HOST=0.0.0.0
PORT=8080

CONTROL_PLANE_BACKEND=postgres
SWEEP_STATE_BACKEND=postgres
BROKER_SECRET_BACKEND=postgres
CONTROL_PLANE_PG_HOST=host.docker.internal
CONTROL_PLANE_PG_PORT=5432
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
CONTROL_PLANE_PG_PASSWORD=CHANGE_ME
CONTROL_PLANE_PG_SSLMODE=require
POSTGRES_FORCE_IPV4=true
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

DEFAULT_TIME_ZONE=Asia/Kolkata
APP_RUNTIME_STARTUP_VALIDATE=true
SCHEMA_CHECK_MODE=strict
RUNTIME_CONFIG_AUTO_ENABLE=false
RUNTIME_CONFIG_ENABLED=false

ENABLE_DEMO_AUTH=false
DASHBOARD_AUTH_DISABLED=false
DISABLE_CONTROL_TOWER_ROUTES=false
ADMIN_API_KEY=CHANGE_ME
DEMO_AUTH_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_STRING
ANGEL_POSTBACK_TOKEN=CHANGE_ME  # REQUIRED: shared secret for Angel broker order-fill postbacks (§126); Angel returns HTTP 401 without this

USE_HUB_ROUTER=true
ENABLE_MULTI_HUB=true
DISABLE_STREAM_WORKER=false
TRADE_MODE=LIVE
REQUIRE_LIVE_TRADE_MODE=true
LEADER_LEASE_ENABLED=true
BROKER_SCHEMA_CHECK_MODE=strict
# Canonical risk state file path; should be on a separate volume from logs.
RISK_STATE_PATH=/app/state/risk_positions.json

ENABLE_CAPITAL_CHECKS=true
CAPITAL_FAIL_CLOSED_ON_MISSING_STATE=true
CAPITAL_FAIL_CLOSED_ON_MISSING_NOTIONAL_PRICE=true
# CAPITAL_LIMITS_JSON: REQUIRED in LIVE. Set per-account capital caps (INR).
# Example structure (replace A1 with your broker_account_id):
#   CAPITAL_LIMITS_JSON={"A1": {"max_gross_notional": 500000, "max_net_notional": 300000}}
# If using global defaults only (not recommended for funded accounts), set the override flag:
# CAPITAL_LIMITS_JSON=
# ALLOW_LIVE_CAPITAL_LIMITS_DEFAULT_ONLY=true
ALLOW_LIVE_CAPITAL_LIMITS_DEFAULT_ONLY=true
ENABLE_RISK_CHECKS=true
RISK_ENABLE_DAILY_LOSS=true
RISK_MAX_DAILY_LOSS=2000
ENABLE_PROFIT_CHECKS=true
PROFIT_ENABLE_DAILY_TARGET=true
PROFIT_DAILY_TARGET=10000
PROFIT_BLOCK_NEW_ORDERS_ON_TARGET=true
ORDER_ROUTER_ENFORCE_IDEMPOTENCY=true
POSITION_OWNERSHIP_ENABLED=true
POSITION_OWNERSHIP_UNKNOWN_MODE=block_entries
OWNERSHIP_PERSIST_PENDING_LOCKS=true
ORDER_SUBMISSION_OUTBOX_REQUIRED=true
ORDER_LIFECYCLE_PERSIST_MARKERS_REQUIRED=true
CIRCUIT_BREAKER_PERSIST_STATE=true
HUB_INSTANCE_NAME=phoenix-live-1
ENABLE_EOD_EXIT=true
EOD_CANCEL_OPEN_ORDERS_ENABLED=true

# Profit sweep
PROFIT_SWEEP_ENABLED=true
PROFIT_SWEEP_STRATEGY=SIMPLE
PROFIT_SIMPLE_ENABLED=true
PROFIT_MULTIPLE_ENABLED=false
PROFIT_SWEEP_COOLDOWN_MINUTES=30
PROFIT_MAX_SWEEPS_PER_DAY=5

# Capital margin mode
CAPITAL_MARGIN_CHECK_MODE=enforce

# Position sync
POSITION_SYNC_INTERVAL_SECONDS=90
ORDERS_SYNC_INTERVAL_SECONDS=90

# Outbox / position / marker retention
OUTBOX_RETENTION_DAYS=90
POSITION_RETENTION_DAYS=90
MARKERS_RETENTION_DAYS=180

# Observability
ORDER_CSV_ENABLED=true
TRADE_CSV_ENABLED=true
INDICATOR_CSV_ENABLED=true
INDICATOR_POSTGRES_ENABLED=true
INDICATOR_POSTGRES_TABLE=indicator_bars
INDICATOR_POSTGRES_RETENTION_MONTHS=3

# Broker network identity: REQUIRED IN LIVE — Angel One uses these for session binding.
# Startup will fail with a validation error if these are absent or loopback values.
CLIENT_LOCAL_IP=CHANGE_ME      # LAN IP of the machine running Docker (e.g. 192.168.1.10)
CLIENT_PUBLIC_IP=CHANGE_ME     # Public IP as seen by Angel One (e.g. 203.0.113.42)
MAC_ADDRESS=CHANGE_ME          # MAC address of the primary NIC (e.g. AA:BB:CC:DD:EE:FF)

# Outbound HTTP proxy for Angel One API and WebSocket (OCI/cloud deployments only).
# Angel One's SmartAPI firewall blocks known cloud-provider IP ranges at the TCP level.
# Set this to an HTTP CONNECT proxy on a non-cloud IP that can reach apiconnect.angelone.in.
# Leave unset for local Docker Desktop deployments where Angel One is directly reachable.
# ANGEL_HTTPS_PROXY=http://<proxy-host>:<port>

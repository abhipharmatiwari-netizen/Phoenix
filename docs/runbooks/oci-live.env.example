# OCI VM phoenix-deploy.env template
#
# Status: current template shape for /opt/phoenix/phoenix-deploy.env on the OCI VM
# verified on 2026-06-06. Keep this file non-secret.
#
# Do not copy values from the VM into this file. Use placeholders only.
# Secrets are mounted from /run/secrets and are not set here.

# Image tag currently selects local images through /opt/phoenix/phoenix-override.yml:
#   phoenix-local-backend:${IMAGE_TAG}
#   phoenix-local-nginx:${IMAGE_TAG}
# The verified VM deploy tag was local-2884a87. Verify container images before
# restart approval.
IMAGE_TAG=local-CHANGE_ME

# OCIR variables remain present in the env file because the base Compose file
# still references them. They are not proof that OCIR images are running.
OCIR_NAMESPACE=CHANGE_ME
OCIR_REGION=ap-mumbai-1

# Current VM-local Postgres connection.
CONTROL_PLANE_PG_HOST=phoenix-oci-postgres
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
# Used by migrator/preflight containers. The current VM-local DB uses prefer;
# with LIVE_PG_SSL_SKIP_CHECK=true this is accepted only as audited info-level
# telemetry when the DB host is recognized as local Docker Postgres and the
# Postgres port is not externally published. External/cloud Postgres should use
# require.
CONTROL_PLANE_PG_SSLMODE_HOST=prefer
# CONTROL_PLANE_PG_PASSWORD_HOST is supplied at compose command time from
# /run/secrets/control_plane_pg_password for services that need interpolation.

# Hub / tenant routing.
HUB_DEFAULT_TENANT_ID=CHANGE_ME
HUB_DEFAULT_BROKER_ACCOUNT_ID=CHANGE_ME
HUB_ROUTES_JSON=CHANGE_ME

# Risk / capital.
RISK_MAX_DAILY_LOSS=CHANGE_ME
PROFIT_DAILY_TARGET=CHANGE_ME
CAPITAL_LIMITS_JSON=CHANGE_ME

# Broker network identity. These are sensitive infrastructure details; keep
# real values only on the VM/operator secret store, not in git.
CLIENT_LOCAL_IP=CHANGE_ME
CLIENT_PUBLIC_IP=CHANGE_ME
MAC_ADDRESS=CHANGE_ME

# Domain / host paths.
PHOENIX_DOMAIN=CHANGE_ME
PHOENIX_LOG_HOST_PATH=/opt/phoenix/logs
PHOENIX_STATE_HOST_PATH=/opt/phoenix/state
PHOENIX_CERTS_HOST_PATH=/opt/phoenix/certs

# Current strategy/runtime tuning. Live strategy routing is EMA20-only.
AUTO_STRATEGY_MAX_ACTIVE_PER_UNDERLYING=1
AUTO_STRATEGY_MIN_HOLD_SECONDS=180
PROFIT_MULTIPLE_TARGET=500
PROFIT_SWEEP_COOLDOWN_MINUTES=30
PROFIT_MAX_SWEEPS_PER_DAY=5
NIFTY_EMA20_LOTS=1
BANKNIFTY_EMA20_LOTS=1
FINNIFTY_EMA20_LOTS=1
MIDCPNIFTY_EMA20_LOTS=1
SENSEX_EMA20_LOTS=1
NG_EMA20_LOTS=1

# OCI Live deployment env reference
#
# Used by: /opt/phoenix/phoenix-deploy.env on the OCI VM
# Consumed by: docker compose --env-file phoenix-deploy.env
#
# This file is a TEMPLATE. Replace every CHANGE_ME value with the real value
# from the ops secrets store. NEVER commit a filled copy to git.
#
# Secrets (ADMIN_API_KEY, PG_PASSWORD, ANGEL_POSTBACK_TOKEN, AUTH_TOKEN_SECRET)
# come from OCI Vault via /run/secrets/ — they are NOT set here.
#
# See: docs/runbooks/oci_live_deployment.md

# OCI Container Registry
OCIR_NAMESPACE=CHANGE_ME           # tenancy namespace (retrieve from ops secrets store)
OCIR_REGION=ap-mumbai-1
IMAGE_TAG=CHANGE_ME                # git SHA tag from CI — never use 'latest' in production

# Postgres endpoint. Use an OCI Database private endpoint or another approved
# Postgres endpoint reachable from the OCI VM. Remote/cloud Postgres requires SSL.
CONTROL_PLANE_PG_HOST=CHANGE_ME
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
# CONTROL_PLANE_PG_PASSWORD_HOST — comes from /run/secrets/control_plane_pg_password at runtime

# Hub / tenant
HUB_DEFAULT_TENANT_ID=CHANGE_ME           # real production tenant UUID (not 'tenant-default')
HUB_DEFAULT_BROKER_ACCOUNT_ID=CHANGE_ME   # real broker account ID

# Risk / capital (INR) — set real values; do not leave as defaults
RISK_MAX_DAILY_LOSS=CHANGE_ME      # absolute daily loss limit in INR
PROFIT_DAILY_TARGET=CHANGE_ME      # absolute daily profit target in INR

# Capital limits — MUST be non-empty in LIVE; format: {"<tenant_id>:<account_id>":{...}}
# Example: {"TENANT_ID:ACCOUNT_ID":{"max_gross_exposure":500000,"max_net_exposure":500000}}
CAPITAL_LIMITS_JSON=CHANGE_ME

# Broker network identity — retrieve from ops secrets store; must match Angel One portal whitelist
CLIENT_LOCAL_IP=CHANGE_ME          # VM private IP
CLIENT_PUBLIC_IP=CHANGE_ME         # OCI NAT gateway outbound IP (Angel One whitelist IP)
MAC_ADDRESS=CHANGE_ME              # broker session MAC address

# Domain — must be the actual HTTPS domain; used for CORS and nginx SSL cert path
PHOENIX_DOMAIN=CHANGE_ME           # e.g. myhost.sslip.io or a registered domain

# Host volume paths (OCI NFS or local disk)
PHOENIX_LOG_HOST_PATH=/opt/phoenix/logs
PHOENIX_STATE_HOST_PATH=/opt/phoenix/state
PHOENIX_CERTS_HOST_PATH=/opt/phoenix/certs

# OCI Vault configuration (for fetch-secrets.sh)
OCI_VAULT_ID=CHANGE_ME             # OCID of the phoenix-vault (retrieve from ops secrets store)

# Optional: per-deployment tuning
EOD_EXIT_TIME=15:20
AUTO_STRATEGY_MAX_ACTIVE_PER_UNDERLYING=2
AUTO_STRATEGY_MIN_HOLD_SECONDS=180
PROFIT_MULTIPLE_TARGET=500
PROFIT_SWEEP_COOLDOWN_MINUTES=30
PROFIT_MAX_SWEEPS_PER_DAY=5
NIFTY_EMA20_LOTS=1
BANKNIFTY_EMA20_LOTS=1
FINNIFTY_EMA20_LOTS=1
MIDCPNIFTY_EMA20_LOTS=1
SENSEX_EMA20_LOTS=1
NG_EMA20_LOTS=1

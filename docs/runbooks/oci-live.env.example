# OCI Live deployment env reference
#
# Used by: /opt/phoenix/phoenix-deploy.env on the OCI VM
# Consumed by: docker compose --env-file phoenix-deploy.env
#
# This file is the source of required interpolation variables for docker-compose.oci-live.yml.
# It does NOT contain secrets. Secrets come from OCI Vault via /run/secrets/.
#
# See: docs/runbooks/oci_live_deployment.md

# OCI Container Registry
OCIR_NAMESPACE=bmfve1wf5neh
OCIR_REGION=ap-mumbai-1

# Postgres (local container — no SSL)
CONTROL_PLANE_PG_HOST=phoenix-oci-postgres
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
# CONTROL_PLANE_PG_PASSWORD_HOST — comes from /run/secrets/control_plane_pg_password at runtime

# Hub / tenant
HUB_DEFAULT_TENANT_ID=tenant-1
HUB_DEFAULT_BROKER_ACCOUNT_ID=A1

# Risk / capital (INR)
RISK_MAX_DAILY_LOSS=2000
PROFIT_DAILY_TARGET=10000
CAPITAL_LIMITS_JSON={}

# Broker network identity — must match values in broker_credentials table
# and be the actual outbound IP/MAC of the OCI VM
CLIENT_LOCAL_IP=10.0.2.83
CLIENT_PUBLIC_IP=141.148.216.169   # OCI NAT gateway outbound IP
MAC_ADDRESS=00:00:17:0D:47:39

# Domain — using sslip.io wildcard DNS for free HTTPS without a registered domain
# 161.118.189.93.sslip.io resolves to 161.118.189.93 (the OCI LB public IP)
PHOENIX_DOMAIN=161.118.189.93.sslip.io

# Cloud Run reference profile
#
# Status:
# - Reference and roadmap material only
# - Not the bundled go-live path
# - Not approved for LIVE deployment by itself
# - Keep this file non-secret

LOG_LEVEL=INFO
APP_ENV=production
TZ=Asia/Kolkata
POSTGRES_SESSION_TIMEZONE=Asia/Kolkata
LOG_FILE_PER_PROCESS=false
RUNNER_MODE=uvicorn
HOST=0.0.0.0
PORT=8080

GCP_PROJECT_ID=CHANGE_ME

CONTROL_PLANE_BACKEND=postgres
SWEEP_STATE_BACKEND=postgres
CONTROL_PLANE_PG_HOST=CHANGE_ME
CONTROL_PLANE_PG_PORT=5432
CONTROL_PLANE_PG_DB=phoenix
CONTROL_PLANE_PG_USER=phoenix_app
# Bind DB password via Secret Manager or platform secret injection.
# Do not put a real password in this file.
# CONTROL_PLANE_PG_PASSWORD=<SET_BY_PLATFORM_SECRET>
POSTGRES_FORCE_IPV4=true
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

BROKER_SECRET_BACKEND=secret_manager
ADMIN_API_KEY_SECRET=phoenix-admin-api-key

DEFAULT_TIME_ZONE=Asia/Kolkata
APP_RUNTIME_STARTUP_VALIDATE=true
SCHEMA_CHECK_MODE=strict
RUNTIME_CONFIG_AUTO_ENABLE=false
ENABLE_DEMO_AUTH=false
DASHBOARD_AUTH_DISABLED=false
DISABLE_CONTROL_TOWER_ROUTES=true
# Bind AUTH_TOKEN_SECRET via Secret Manager or platform secret injection.
# AUTH_TOKEN_SECRET=<SET_BY_PLATFORM_SECRET>

USE_HUB_ROUTER=true
ENABLE_MULTI_HUB=true
DISABLE_STREAM_WORKER=false
TRADE_MODE=LIVE
REQUIRE_LIVE_TRADE_MODE=true
LEADER_LEASE_ENABLED=true

ENABLE_CAPITAL_CHECKS=true
CAPITAL_FAIL_CLOSED_ON_MISSING_STATE=true
CAPITAL_FAIL_CLOSED_ON_MISSING_NOTIONAL_PRICE=true
# Capital limits are injected at deploy time via CAPITAL_LIMITS_JSON env var override
# in the Cloud Run revision. This example sets the audited exception flag so the
# profile lint passes; override CAPITAL_LIMITS_JSON at deploy time for funded accounts.
ALLOW_LIVE_CAPITAL_LIMITS_DEFAULT_ONLY=true
ENABLE_RISK_CHECKS=true
RISK_ENABLE_DAILY_LOSS=true
RISK_MAX_DAILY_LOSS=CHANGE_ME_DAILY_LOSS_INR
RISK_LIVE_MIN_DAILY_LOSS_INR=5000
RISK_LIVE_LOW_DAILY_LOSS_ACTION=warn
ENABLE_PROFIT_CHECKS=true
PROFIT_ENABLE_DAILY_TARGET=true
PROFIT_DAILY_TARGET=10000
PROFIT_BLOCK_NEW_ORDERS_ON_TARGET=true
ORDER_ROUTER_ENFORCE_IDEMPOTENCY=true
POSITION_OWNERSHIP_ENABLED=true
POSITION_OWNERSHIP_UNKNOWN_MODE=block_entries
OWNERSHIP_PERSIST_PENDING_LOCKS=true
ORDER_LIFECYCLE_PERSIST_MARKERS_REQUIRED=true
ORDER_SUBMISSION_OUTBOX_REQUIRED=true
CIRCUIT_BREAKER_PERSIST_STATE=true
HUB_INSTANCE_NAME=phoenix-live-1
HUB_DEFAULT_TENANT_ID=tenant-1
ENABLE_EOD_EXIT=true
EOD_CANCEL_OPEN_ORDERS_ENABLED=true
